---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TechTag from '@/components/TechTag.astro';
import { site } from '@/config';
import { getExperience, getWork, workHref, contextLabel } from '@/lib/content';

const experience = await getExperience();
const work = await getWork();
// Only projects that appear on the resume PDF (Portfolio still shows them all).
const resumeProjects = work.filter((w) => w.data.onResume);
const workBySlug = new Map(
  work.map((w) => [w.id.replace(/\.mdx?$/, ''), w])
);
---

<BaseLayout title="Resume" description={`Resume, experience, education, and skills for ${site.name}.`}>
  <!-- Banner -->
  <section class="banner">
    <div class="banner-bg" aria-hidden="true"></div>
    <div class="container banner-inner reveal">
      <h1 class="display display-xl">Resume</h1>
      <a class="btn btn-primary dl" href={site.resumePath} download>
        <span class="btn-label">Download PDF ↓</span>
      </a>
    </div>
  </section>

  <section class="section section--light">
    <div class="container resume-grid">
      <!-- Main column -->
      <div class="resume-main">
        <div class="block reveal">
          <p class="eyebrow">Experience</p>
          <h2 class="display display-md">Where I've Worked</h2>
        </div>

        <ol class="timeline">
          {
            experience.map((exp) => {
              const related = exp.data.related
                .map((slug) => workBySlug.get(slug))
                .filter((w) => Boolean(w));
              return (
                <li class="entry entry--exp reveal">
                  {exp.data.logo && (
                    <div class="entry-logo" data-company={exp.data.company}>
                      <img src={exp.data.logo} alt={`${exp.data.company} logo`} loading="lazy" />
                    </div>
                  )}
                  <div class="entry-content">
                    <div class="entry-head">
                      <h3 class="entry-role">
                        {exp.data.role} <span class="at">·</span> {exp.data.company}
                      </h3>
                      <span class="entry-dates">
                        {exp.data.startDate} to {exp.data.endDate}
                      </span>
                    </div>
                    {exp.data.location && <p class="entry-loc">{exp.data.location}</p>}
                    <p class="entry-summary">{exp.data.summary}</p>
                    {exp.data.tech.length > 0 && (
                      <div class="entry-tech">
                        {exp.data.tech.map((t) => (
                          <TechTag label={t} />
                        ))}
                      </div>
                    )}
                    {related.length > 0 && (
                      <p class="entry-related">
                        {related.map((w) => (
                          <a href={workHref(w!)}>{w!.data.title} →</a>
                        ))}
                      </p>
                    )}
                  </div>
                </li>
              );
            })
          }
        </ol>

        <div class="block reveal edu-head">
          <p class="eyebrow">Education</p>
          <h2 class="display display-md">Education</h2>
        </div>
        <ol class="timeline">
          {
            site.education.map((ed) => (
              <li class="entry reveal">
                <div class="entry-head">
                  <h3 class="entry-role">{ed.school}</h3>
                  <span class="entry-dates">{ed.dates}</span>
                </div>
                <p class="entry-loc">{ed.credential}</p>
                <p class="entry-summary">{ed.detail}</p>
              </li>
            ))
          }
        </ol>

        <div class="block reveal edu-head">
          <p class="eyebrow">Honors</p>
          <h2 class="display display-md">Honors</h2>
        </div>
        <ol class="timeline">
          {
            site.honors.map((h) => (
              <li class="entry entry--exp reveal">
                {h.logo && (
                  <div class="entry-logo">
                    <img src={h.logo} alt={`${h.org} emblem`} loading="lazy" />
                  </div>
                )}
                <div class="entry-content">
                  <div class="entry-head">
                    <h3 class="entry-role">
                      {h.title} <span class="at">·</span> {h.org}
                    </h3>
                    <span class="entry-dates">{h.dates}</span>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="block reveal edu-head">
          <p class="eyebrow">Projects</p>
          <h2 class="display display-md">Projects</h2>
        </div>
        <ol class="timeline">
          {
            resumeProjects.map((w) => (
              <li class="entry reveal">
                <div class="entry-head">
                  <h3 class="entry-role">
                    <a class="proj-link" href={workHref(w)}>
                      {w.data.title} →
                    </a>
                  </h3>
                  <span class="entry-dates">{contextLabel(w.data)}</span>
                </div>
                <p class="entry-summary">{w.data.summary}</p>
                {w.data.tech.length > 0 && (
                  <div class="entry-tech">
                    {w.data.tech.slice(0, 5).map((t) => (
                      <TechTag label={t} />
                    ))}
                  </div>
                )}
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Sidebar -->
      <aside class="resume-side">
        <div class="side-card reveal">
          <p class="eyebrow">Skills</p>
          <dl class="skills">
            {
              site.skills.map((group) => (
                <div class="skill-group">
                  <dt>{group.group}</dt>
                  <dd>
                    {group.items.map((i) => (
                      <span class="tag">{i}</span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="side-card reveal">
          <p class="eyebrow">Get the PDF</p>
          <p class="side-note">Prefer the one-page version?</p>
          <a class="btn" href={site.resumePath} download><span class="btn-label">Download PDF ↓</span></a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .banner {
    position: relative;
    min-height: 58svh;
    display: flex;
    align-items: center;
    background: var(--night);
    color: #fff;
    overflow: hidden;
    text-align: center;
  }
  .banner-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(8, 10, 15, 0.62), rgba(8, 10, 15, 0.82)) center / cover no-repeat,
      url('/images/circuit-bg.jpg') center / cover no-repeat;
  }
  .banner-inner {
    position: relative;
    z-index: 1;
    padding-top: 4.5rem;
    width: 100%;
  }
  .banner h1 { color: #fff; }
  .dl { margin-top: 1.75rem; color: #06213f; }

  .resume-grid {
    display: grid;
    grid-template-columns: 1.65fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .block { margin-bottom: 1.75rem; }
  .block h2 { margin-top: 0.4rem; }
  .edu-head { margin-top: 3.5rem; }

  .timeline { list-style: none; margin: 0; padding: 0; }
  .entry {
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .entry:last-child { border-bottom: 1px solid var(--line); }

  /* Experience rows: logo tile + content */
  .entry--exp {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
  }
  .entry-content { flex: 1; min-width: 0; }
  .entry-logo {
    flex: 0 0 auto;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    overflow: hidden;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.2rem;
  }
  .entry-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* MOVD mark is white on black, fill the tile so it reads */
  .entry-logo[data-company='MOVD'] { background: #000; border-color: #000; }
  @media (max-width: 520px) {
    .entry-logo { width: 2.75rem; height: 2.75rem; }
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }
  .entry-role {
    font-family: var(--font-sans);
    text-transform: none;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--ink);
  }
  .at { color: var(--accent-ink); }
  .entry-dates {
    font-size: 0.85rem;
    color: var(--ink-muted);
    font-weight: 500;
    white-space: nowrap;
  }
  .entry-loc {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }
  .entry-summary { margin: 0.75rem 0 0; color: var(--ink-soft); }
  .entry-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }
  .entry-related {
    margin: 0.85rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .resume-side {
    position: sticky;
    top: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .side-card {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .skills { margin: 0.75rem 0 0; }
  .skill-group { margin-bottom: 1rem; }
  .skill-group:last-child { margin-bottom: 0; }
  .skill-group dt {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .skill-group dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .side-note { color: var(--ink-muted); font-size: 0.95rem; margin: 0.5rem 0 1rem; }
  .side-card .btn { color: var(--ink); }

  @media (max-width: 820px) {
    .resume-grid { grid-template-columns: 1fr; }
    .resume-side { position: static; }
  }
</style>
