---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkCard from '@/components/WorkCard.astro';
import { site } from '@/config';
import { getWork } from '@/lib/content';

const work = await getWork();
const featured = work.filter((w) => w.data.featured).slice(0, 4);
const showcase = featured.length > 0 ? featured : work.slice(0, 4);
---

<BaseLayout>
  <!-- Hero -->
  <section class="section hero">
    <div class="container">
      <p class="mono-label">whoami</p>
      <h1 class="hero-title">
        {site.name}<span class="cursor" aria-hidden="true">_</span>
      </h1>
      <p class="hero-role">{site.role}</p>
      <p class="hero-tagline">{site.tagline}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/work">View work</a>
        <a class="btn" href={site.resumePath}>Resume ↗</a>
        {site.socials.map((s) => <a class="hero-social" href={s.href} rel="me noopener">{s.label}</a>)}
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="mono-label">featured</p>
        <a class="see-all" href="/work">all work →</a>
      </div>
      <div class="grid">
        {showcase.map((entry) => <WorkCard entry={entry} />)}
      </div>
    </div>
  </section>

  <!-- About snippet -->
  <section class="section">
    <div class="container about-snip">
      <p class="mono-label">about</p>
      <p class="about-text">{site.bio[0]}</p>
      <a class="btn" href="/about">More about me</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 5rem 3rem;
  }
  .hero-title {
    font-size: clamp(2.4rem, 7vw, 4rem);
    margin: 0.5rem 0 0;
    letter-spacing: -0.02em;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .hero-role {
    font-family: var(--font-mono);
    color: var(--accent);
    margin: 0.75rem 0 0;
    font-size: 1rem;
  }
  .hero-tagline {
    max-width: 40rem;
    color: var(--text-muted);
    font-size: 1.15rem;
    margin: 1rem 0 1.75rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .hero-social {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    padding: 0.35rem 0.25rem;
  }
  .hero-social:hover { color: var(--accent); }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .see-all:hover { color: var(--accent); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .about-snip {
    border-top: var(--border-width) solid var(--border);
    padding-top: 3rem;
  }
  .about-text {
    max-width: 44rem;
    color: var(--text);
    font-size: 1.05rem;
    margin: 0.75rem 0 1.5rem;
  }
</style>
