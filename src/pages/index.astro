---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectThumb from '@/components/ProjectThumb.astro';
import { site } from '@/config';
import { getWork } from '@/lib/content';

const work = await getWork();
const featured = work.filter((w) => w.data.featured).slice(0, 3);
const showcase = featured.length > 0 ? featured : work.slice(0, 3);
const homeCols = Math.min(3, Math.max(1, showcase.length));
---

<BaseLayout>
  <!-- 1 · Hero -->
  <section class="hero viewport">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner reveal">
      <p class="hero-hi eyebrow">Hi, I'm</p>
      <h1 class="display display-xl hero-name">{site.name}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/portfolio"><span class="btn-label">View portfolio</span></a>
        <a class="btn" href="/resume"><span class="btn-label">Resume</span></a>
      </div>
    </div>
    <a href="#intro" class="scroll-cue" aria-label="Scroll down">
      <span></span>
    </a>
  </section>

  <!-- 2 · Intro / about -->
  <section id="intro" class="section section--light">
    <div class="container intro-grid">
      <div class="intro-photo reveal" aria-hidden="true">
        <!-- TODO: replace with a real headshot at /images/headshot.jpg -->
        <div class="photo-placeholder"><span>Your photo</span></div>
      </div>
      <div class="intro-copy">
        <p class="eyebrow reveal">About</p>
        <h2 class="display display-lg reveal" data-delay="1">
          {site.role} building things that matter
        </h2>
        <p class="intro-text reveal" data-delay="2">{site.bio[0]}</p>
        <a class="btn intro-btn reveal" data-delay="2" href="/contact"
          ><span class="btn-label">Get in touch</span></a
        >
      </div>
    </div>
  </section>

  <!-- 3 · Selected work -->
  <section class="section section--dark">
    <div class="container-wide">
      <div class="work-head">
        <div>
          <p class="eyebrow reveal">Selected work</p>
          <h2 class="display display-lg reveal" data-delay="1">Featured Projects</h2>
        </div>
        <a class="work-all reveal" data-delay="1" href="/portfolio">All projects →</a>
      </div>
      <div class="home-grid" style={`--home-cols:${homeCols}`}>
        {showcase.map((entry) => <ProjectThumb entry={entry} />)}
      </div>
    </div>
  </section>

  <!-- 4 · Contact CTA -->
  <section class="section section--light cta">
    <div class="container cta-inner reveal">
      <p class="eyebrow">Let's connect</p>
      <h2 class="display display-lg cta-title">Have a project or role in mind?</h2>
      <a class="btn btn-primary" href="/contact"><span class="btn-label">Contact me</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    background: var(--night);
    color: var(--on-night);
    overflow: hidden;
    text-align: center;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(8, 10, 15, 0.62), rgba(8, 10, 15, 0.82)) center / cover no-repeat,
      url('/images/circuit-bg.jpg') center / cover no-repeat;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 4.5rem;
  }
  .hero-hi {
    display: block;
    margin-bottom: 0.75rem;
  }
  .hero-name {
    color: #fff;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.4);
  }
  .hero-tagline {
    max-width: 44rem;
    margin: 1.5rem auto 2rem;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
  }
  .hero-actions {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero .btn { color: #fff; }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 14px;
    z-index: 1;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    background: #fff;
    border-radius: 2px;
    animation: cue 1.6s infinite;
  }
  @keyframes cue {
    0% { opacity: 0; transform: translateY(0); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(14px); }
  }

  /* Intro */
  .intro-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .photo-placeholder {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(45deg, #eceef1 0 12px, #e6e8ec 12px 24px);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-muted);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .intro-copy h2 {
    margin: 0.6rem 0 1.1rem;
    max-width: 18ch;
  }
  .intro-text {
    color: var(--ink-soft);
    font-size: 1.1rem;
    max-width: 42ch;
  }
  .intro-btn { margin-top: 1.5rem; color: var(--ink); }

  /* Selected work */
  .work-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .work-head h2 { margin-top: 0.5rem; }
  .work-all {
    color: var(--on-night);
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .work-all:hover { color: var(--accent); }
  .home-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 680px) {
    .home-grid { grid-template-columns: repeat(min(var(--home-cols, 3), 2), 1fr); }
  }
  @media (min-width: 980px) {
    .home-grid { grid-template-columns: repeat(var(--home-cols, 3), 1fr); }
  }
  .section--dark .thumb,
  .section--dark .thumb:hover { color: var(--on-night); }
  .section--dark :global(.thumb-title) { color: var(--on-night); }
  .section--dark :global(.thumb-summary) { color: var(--on-night-muted); }
  .section--dark :global(.thumb-context) { color: var(--accent); }

  /* CTA */
  .cta-inner { text-align: center; }
  .cta-title {
    margin: 0.6rem 0 1.6rem;
    max-width: 20ch;
    margin-inline: auto;
  }
  .cta .btn { color: var(--ink); }

  @media (max-width: 720px) {
    .intro-grid { grid-template-columns: 1fr; }
    .intro-photo { max-width: 22rem; }
    .work-head { flex-direction: column; align-items: flex-start; }
  }
</style>
