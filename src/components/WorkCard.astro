---
import type { WorkEntry } from '@/lib/content';
import { contextLabel, statusLabel, formatDate, workHref } from '@/lib/content';
import TechTag from './TechTag.astro';

interface Props {
  entry: WorkEntry;
}
const { entry } = Astro.props;
const { data } = entry;
const href = workHref(entry);
const tech = data.tech.slice(0, 5);
const extra = data.tech.length - tech.length;
---

<article class="card work-card" data-context={data.context} data-tech={data.tech.join(',')}>
  <a href={href} class="cover-link" aria-label={data.title}>
    {
      data.cover ? (
        <img class="cover" src={data.cover} alt="" loading="lazy" width="640" height="320" />
      ) : (
        <div class="cover cover-placeholder" aria-hidden="true">
          <span>{'</>'}</span>
        </div>
      )
    }
  </a>

  <div class="body">
    <div class="meta">
      <span class:list={['context', data.context]}>{contextLabel(data)}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span class="status" data-status={data.status}>{statusLabel(data.status)}</span>
      <span class="date">{formatDate(data.date)}</span>
    </div>

    <h3 class="title">
      <a href={href}>{data.title}</a>
    </h3>
    <p class="summary">{data.summary}</p>

    {
      tech.length > 0 && (
        <div class="tech">
          {tech.map((t) => (
            <TechTag label={t} />
          ))}
          {extra > 0 && <span class="tag more">+{extra}</span>}
        </div>
      )
    }
  </div>
</article>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .work-card:hover {
    transform: translateY(-2px);
  }
  .cover-link {
    display: block;
    aspect-ratio: 2 / 1;
    background: var(--bg-inset);
    border-bottom: var(--border-width) solid var(--border);
  }
  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 2rem;
    color: var(--text-faint);
    background:
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 100% 22px,
      var(--bg-inset);
  }
  .body {
    padding: 1.1rem 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .context {
    color: var(--accent);
  }
  .context.personal {
    color: var(--accent-2);
  }
  .dot { color: var(--text-faint); }
  .status { color: var(--text-muted); }
  .date { margin-left: auto; color: var(--text-faint); }

  .title {
    margin: 0;
    font-size: 1.05rem;
  }
  .title a {
    color: var(--text-strong);
  }
  .title a:hover {
    color: var(--accent);
  }
  .summary {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }
  .more { color: var(--text-faint); }
</style>
