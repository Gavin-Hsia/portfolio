---
import BaseLayout from './BaseLayout.astro';
import TechTag from '@/components/TechTag.astro';
import type { WorkEntry } from '@/lib/content';
import { contextLabel, statusLabel, formatDate } from '@/lib/content';

interface Props {
  entry: WorkEntry;
}
const { entry } = Astro.props;
const { data } = entry;
---

<BaseLayout title={data.title} description={data.summary}>
  <!-- Dark header -->
  <header class="work-hero">
    <div class="work-hero-bg" aria-hidden="true"></div>
    <div class="container work-hero-inner reveal">
      <a href="/portfolio" class="back">← Back to portfolio</a>
      <p class="eyebrow work-context">{contextLabel(data)}</p>
      <h1 class="display display-lg">{data.title}</h1>
      <p class="work-summary">{data.summary}</p>
      <div class="work-meta">
        <span>{statusLabel(data.status)}</span>
        <span class="sep">·</span>
        <span>{formatDate(data.date)}</span>
      </div>
      {
        data.tech.length > 0 && (
          <div class="work-tech">
            {data.tech.map((t) => (
              <TechTag label={t} />
            ))}
          </div>
        )
      }
      {
        (data.repo || data.demo) && (
          <div class="work-links">
            {data.repo && (
              <a class="btn" href={data.repo} rel="noopener">
                <span class="btn-label">Source ↗</span>
              </a>
            )}
            {data.demo && (
              <a class="btn btn-primary" href={data.demo} rel="noopener">
                <span class="btn-label">Live demo ↗</span>
              </a>
            )}
          </div>
        )
      }
    </div>
  </header>

  <!-- Light body -->
  <section class="section section--light">
    <div class="container">
      {data.cover && <img class="cover" src={data.cover} alt={`${data.title} cover`} />}
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-hero {
    position: relative;
    background: var(--night);
    color: #fff;
    padding-block: 8.5rem 4rem;
    overflow: hidden;
  }
  .work-hero-bg {
    position: absolute;
    inset: 0;
    background: url('/images/circuit-bg.svg') center / cover no-repeat;
    opacity: 0.85;
  }
  .work-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 52rem;
  }
  .back {
    display: inline-block;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 500;
    font-size: 0.9rem;
    margin-bottom: 1.75rem;
  }
  .back:hover { color: #fff; }
  .work-context { color: var(--accent); }
  .work-hero h1 { color: #fff; margin: 0.6rem 0 1rem; }
  .work-summary {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 44rem;
    margin: 0 0 1.25rem;
  }
  .work-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1.25rem;
  }
  .work-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }
  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .work-links .btn { color: #fff; }
  .work-links .btn-primary { color: #06213f; }

  .cover {
    width: 100%;
    border-radius: var(--radius);
    margin: 0 auto 2.5rem;
    max-width: 52rem;
  }
  .section--light .prose { margin-inline: auto; }
</style>
